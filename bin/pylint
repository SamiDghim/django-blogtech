#!/bin/bash
# StudyBuddy Pylint Analysis Script
# Usage: ./bin/pylint [target]

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default target
TARGET=${1:-"base/ studybud/"}

echo -e "${BLUE}🔍 Running advanced code analysis with Pylint...${NC}"

# Check if Docker is running
if ! docker-compose ps | grep -q "web.*Up"; then
    echo -e "${YELLOW}⚠️  Starting Django container...${NC}"
    docker-compose up -d web
    sleep 2
fi

echo -e "${BLUE}Running Pylint with Django plugin...${NC}"
docker-compose exec web pylint $TARGET --load-plugins=pylint_django

echo -e "${GREEN}🎉 Pylint analysis completed!${NC}"
