#!/bin/bash
# StudyBuddy Linting Script
# Usage: ./bin/lint [target]

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default target
TARGET=${1:-"base/ studybud/"}

echo -e "${BLUE}🔍 Running linting checks...${NC}"

# Check if Docker is running
if ! docker-compose ps | grep -q "web.*Up"; then
    echo -e "${YELLOW}⚠️  Starting Django container...${NC}"
    docker-compose up -d web
    sleep 2
fi

echo -e "${BLUE}Running flake8...${NC}"
if docker-compose exec web flake8 $TARGET; then
    echo -e "${GREEN}✅ flake8 passed${NC}"
else
    echo -e "${RED}❌ flake8 found issues${NC}"
    exit 1
fi

echo -e "${BLUE}Running Black check...${NC}"
if docker-compose exec web black --check $TARGET; then
    echo -e "${GREEN}✅ Black formatting check passed${NC}"
else
    echo -e "${YELLOW}⚠️  Black found formatting issues. Run ./bin/format to fix.${NC}"
    exit 1
fi

echo -e "${BLUE}Running isort check...${NC}"
if docker-compose exec web isort --check-only $TARGET; then
    echo -e "${GREEN}✅ isort import order check passed${NC}"
else
    echo -e "${YELLOW}⚠️  isort found import order issues. Run ./bin/format to fix.${NC}"
    exit 1
fi

echo -e "${GREEN}🎉 All linting checks passed!${NC}"
